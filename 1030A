import java.util.Scanner;

public class Zero {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();

        int[] arr = new int[n];
        for(int i=0; i<n;i++){
            arr[i]=sc.nextInt();
        }
        boolean foundOne = false;
        for(int i=0; i<n;i++){
            if(arr[i]==1){
                foundOne = true;
                break;
            }
        }

        if(foundOne){
            System.out.println("HARD");
        }else{
            System.out.println("EASY");
        }
        sc.close();
    }
    
}
