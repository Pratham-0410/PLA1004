import java.util.Scanner;

public class Anton {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        String str = sc.next();

        int a = 0;
        int b = 0;

        for (int i = 0; i < n; i++) {

            if (str.charAt(i) == 'A') {
                a++;
            } else if (str.charAt(i) == 'D') {
                b++;
            }
        }

        if (a > b) {
            System.out.println("Anton");
        } else if (b > a) {
            System.out.println("Danik");
        } else {
            System.out.println("Friendship");
        }

        sc.close();
    }
}
